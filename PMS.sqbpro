ALTER TABLE fixture_boms RENAME TO fixture_boms_old;

-- 新建表，使用 bom_id 做主鍵
CREATE TABLE fixture_boms (
    bom_id INTEGER PRIMARY KEY AUTOINCREMENT,
    parent_part_no TEXT,
    child_part_no TEXT,
    bom_qty INTEGER,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);

-- 如果舊表有資料，需要轉移
INSERT INTO fixture_boms (parent_part_no, child_part_no, bom_qty, created_at)
SELECT parent_part_no, child_part_no, bom_qty, created_at
FROM fixture_boms_old;

-- 檢查後可以刪除舊表
DROP TABLE fixture_boms_old;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
